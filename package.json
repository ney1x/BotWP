{
  "name": "botwp",
  "version": "0.2.0",
  "private": true,
  "description": "Bot de WhatsApp para Franky's Efectivo (Miami): precio del oro, divisas, tienda, empeño y paso a asesor.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "simular": "tsx --env-file-if-exists=.env src/simulador.ts",
    "reporte": "tsx --env-file-if-exists=.env src/reporte.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
