# Copiar a .env (nunca se sube). En Railway se cargan como variables del servicio.

PORT=3000

# --- WhatsApp Cloud API (Meta) ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
# Texto que usted inventa y pega también en Meta al configurar el webhook
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v25.0

# --- IA ---
ANTHROPIC_API_KEY=
IA_MODELO=claude-haiku-5-5

# --- Datos ---
# Vacío = memoria (se pierde al reiniciar). En Railway: la variable del plugin Postgres.
DATABASE_URL=
# Planilla de Google Sheets publicada como CSV (columnas: moneda,compra,venta,confirmado)
DIVISAS_CSV_URL=

# --- Negocio ---
ZONA_HORARIA=America/New_York
# Feriados cerrados, separados por coma (ejemplo: confirmar con el cliente)
FERIADOS=2026-11-26,2026-12-25,2027-01-01
# Número (solo dígitos, con código de país) que recibe las fichas para asesor
ASESOR_WHATSAPP=
# Números bloqueados, separados por coma
BLOQUEADOS=

# --- Límites ---
LIMITE_IA_DIA=20
LIMITE_RESPUESTAS_DIA=40
PAUSA_ASESOR_HORAS=4
GASTO_ALERTA_USD_DIA=2
RETENCION_DIAS=90
